{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist/web-angular/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://3.233.132.212/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
